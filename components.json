{
  "aliases": {
    /* UI Layer */
    "ui": "@/components/ui",
    "components": "@/components",
    "layouts": "@/components/layouts",

    /* Logic Layer */
    "utils": "@/lib/utils",
    "lib": "@/lib",
    "hooks": "@/hooks",
    "services": "@/services",

    /* State & Config */
    "store": "@/store",
    "config": "@/config",

    /* Assets */
    "assets": "@/assets",
    "styles": "@/styles"
  },

  "bestPractices": {
    "separation": "UI, logic, and state are modular",
    "scalability": "Aliases reduce import complexity",
    "maintainability": "Clear folder boundaries"
  }
}
